"""**Handling missing values**"""

for column in numerical_features:
    df[column] = df[column].fillna(df[column].median())

categorical_features = [
    "anaemia",
    "diabetes",
    "high_blood_pressure",
    "sex",
    "smoking"
]

for column in categorical_features:
    df[column] = df[column].fillna(df[column].mode()[0])

print("Missing values handled.")
print("Total missing values:", df.isnull().sum().sum())

"""**Outliers Detection Using IQR**"""

outlier_counts = {}

for column in numerical_features:

    Q1 = df[column].quantile(0.25)
    Q3 = df[column].quantile(0.75)

    IQR = Q3 - Q1

    lower_bound = Q1 - 1.5 * IQR
    upper_bound = Q3 + 1.5 * IQR

    outliers = df[
        (df[column] < lower_bound) |
        (df[column] > upper_bound)
    ]

    outlier_counts[column] = len(outliers)

display(
    pd.DataFrame(
        outlier_counts.items(),
        columns=["Feature", "Outlier Count"]
    )
)

"""**Removing outliers**"""

df_clean = df.copy()

for column in numerical_features:

    Q1 = df_clean[column].quantile(0.25)
    Q3 = df_clean[column].quantile(0.75)

    IQR = Q3 - Q1

    lower_bound = Q1 - 1.5 * IQR
    upper_bound = Q3 + 1.5 * IQR

    df_clean = df_clean[
        (df_clean[column] >= lower_bound) &
        (df_clean[column] <= upper_bound)
    ]

print("Original rows:", len(df))
print("Cleaned rows:", len(df_clean))
print("Rows removed:", len(df) - len(df_clean))

"""**Checking for Invalid Values**"""

print("Negative ages:", (df_clean["age"] < 0).sum())

binary_columns = [
    "anaemia",
    "diabetes",
    "high_blood_pressure",
    "sex",
    "smoking",
    "DEATH_EVENT"
]

for column in binary_columns:
    print(column, ":", sorted(df_clean[column].unique()))

"""**Creating (age_group)**"""

def create_age_group(age):
    if age < 40:
        return "<40"
    elif age <= 60:
        return "40-60"
    else:
        return ">60"

df_clean["age_group"] = df_clean["age"].apply(create_age_group)

display(
    df_clean[["age", "age_group"]].head(10)
)

print(df_clean["age_group"].value_counts())

"""Create risk_score"""

df_clean["risk_raw"] = (
    df_clean["ejection_fraction"] *
    df_clean["serum_creatinine"]
)

from sklearn.preprocessing import MinMaxScaler

risk_scaler = MinMaxScaler()

df_clean["risk_score"] = risk_scaler.fit_transform(
    df_clean[["risk_raw"]]
)

df_clean.drop(columns=["risk_raw"], inplace=True)

display(
    df_clean[
        ["ejection_fraction", "serum_creatinine", "risk_score"]
    ].head()
)

"""One-hot encoding"""

categorical_columns = [
    "anaemia",
    "diabetes",
    "high_blood_pressure",
    "sex",
    "smoking",
    "age_group"
]

for column in categorical_columns:
    df_clean[column] = df_clean[column].astype(str)

df_encoded = pd.get_dummies(
    df_clean,
    columns=categorical_columns,
    drop_first=True,
    dtype=int
)

display(df_encoded.head())

